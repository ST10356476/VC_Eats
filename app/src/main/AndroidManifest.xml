<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VC_Eats">

        <!-- LoginActivity as the launcher/landing page -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SignUpActivity -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:screenOrientation="portrait" />


        <activity
            android:name=".ProfileInformationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- SettingsActivity - FIXED: removed .activities package -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AlertsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".OrdersActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CustomerMenuActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AnalyticsReportsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".OrderDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MenuManagementActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".StaffDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>